{
  "categories_file": "CATEGORIES.md",

  "source": {
    "kind": "icloud",
    "root": "https://photos.icloud.com/shared/album/095I7-kn_aXH4lPLkr-HjxBTQ/",
    "inbox": "Inbox"
  },

  "embeddings": {
    "provider": "siglip",
    "model": "google/siglip2-base-patch16-224",
    "knn_weight": 0.6,
    "knn_k": 3,
    "use_filed_as_examples": false
  },

  "min_confidence": 0.15,
  "review_category": "Review",
  "review_action": "move",
  "naming": { "pattern": "{slug}_{n:03d}{ext}" },
  "training_subfolder": "_training_data",

  "output": { "folder": "Sorted Photos", "size": "original" }
}
